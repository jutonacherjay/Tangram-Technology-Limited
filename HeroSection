          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          Explore Products
        </a>
        <a href="#" class="tg-btn tg-btn-out">Learn More</a>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var wrapper = document.getElementById('tangram-hero-wrapper');
  var slides = wrapper.querySelectorAll('.tg-slide');
  var dots = wrapper.querySelectorAll('.tg-dot');
  var countBadge = document.getElementById('tgCount');
  var prevBtn = document.getElementById('tgPrev');
  var nextBtn = document.getElementById('tgNext');
  var currentIndex = 0;
  var autoTimer = null;
  var isAnimating = false;
  
  function goToSlide(targetIndex) {
    if (isAnimating) return;
    
    isAnimating = true;
    var prevIndex = currentIndex;
    currentIndex = (targetIndex + slides.length) % slides.length;
    
    // Remove active from previous slide
    slides[prevIndex].classList.remove('active');
    slides[prevIndex].classList.add('slide-out');
    
    // Add active to new slide
    slides[currentIndex].classList.add('slide-in', 'active');
    
    // Update dots
    dots[prevIndex].classList.remove('active');
    dots[currentIndex].classList.add('active');
    
    // Update counter
    countBadge.textContent = (currentIndex + 1) + ' / ' + slides.length;
    
    // Clean up animation classes after animation completes
    setTimeout(function() {
      slides[prevIndex].classList.remove('slide-out');
      slides[currentIndex].classList.remove('slide-in');
      isAnimating = false;
    }, 900);
  }
  
  function navigate(direction) {
    goToSlide(currentIndex + direction);
    
    // Reset auto-play timer
    clearInterval(autoTimer);
    autoTimer = setInterval(function() {
      goToSlide(currentIndex + 1);
    }, 3500);
  }
  
  // Lazy load images
  slides.forEach(function(slide, index) {
    var imgUrl = slide.dataset.src;
    if (imgUrl) {
      var img = new Image();
      img.onload = function() {
        slide.style.backgroundImage = 'url(' + imgUrl + ')';
      };
      img.src = imgUrl;
      
      // Load first image immediately
      if (index === 0) {
        slide.style.backgroundImage = 'url(' + imgUrl + ')';
      }
    }
  });
  
  // Dot click handlers
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var targetIdx = parseInt(dot.dataset.idx);
      goToSlide(targetIdx);
      
      // Reset auto-play timer
      clearInterval(autoTimer);
      autoTimer = setInterval(function() {
        goToSlide(currentIndex + 1);
      }, 3500);
    });
  });
  
  // Navigation button handlers
  if (prevBtn) {
    prevBtn.addEventListener('click', function() {
      navigate(-1);
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      navigate(1);
    });
  }
  
  // Start auto-play
  autoTimer = setInterval(function() {
    goToSlide(currentIndex + 1);
  }, 3500);
})();
</script>

