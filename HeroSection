<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tangram Electronics – Hero</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<style>
#tangram-hero-wrapper {
  all: initial;
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  position: relative;
}

#tangram-hero-wrapper *,
#tangram-hero-wrapper *::before,
#tangram-hero-wrapper *::after {
  all: unset;
  box-sizing: border-box;
}

#tangram-hero-wrapper .tg-hero {
  display: flex;
  position: relative;
  width: 100%;
  max-width: 100%;
  height: 70vh;
  min-height: 460px;
  overflow: hidden;
  background: linear-gradient(120deg, #c8f2ec 0%, #e8f8f5 45%, #b2ece3 100%);
  align-items: center;
}

#tangram-hero-wrapper .tg-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 650px 520px at 68% 50%, rgba(46,207,176,.16) 0%, transparent 70%),
    radial-gradient(ellipse 280px 280px at 15% 80%, rgba(46,207,176,.09) 0%, transparent 70%);
}

#tangram-hero-wrapper .tg-content {
  position: relative;
  z-index: 5;
  width: 50%;
  padding-left: 5%;
  padding-right: 2%;
  flex-shrink: 0;
}

#tangram-hero-wrapper .tg-eyebrow {
  display: inline-block;
  font-family: 'Outfit', sans-serif;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #0a9e84;
  background: rgba(46,207,176,.12);
  border: 1px solid rgba(46,207,176,.35);
  padding: 6px 16px;
  border-radius: 100px;
  margin-bottom: 14px;
  opacity: 0;
  transform: translateY(18px);
  animation: tgFade .7s ease .2s forwards;
}

#tangram-hero-wrapper .tg-h1 {
  display: block;
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.8rem, 5vw, 4.5rem);
  line-height: .93;
  letter-spacing: 1px;
  color: #0d1f1b;
  margin-bottom: 16px;
  opacity: 0;
  transform: translateY(24px);
  animation: tgFade .7s ease .38s forwards;
}

#tangram-hero-wrapper .tg-accent {
  color: #0a9e84;
}

#tangram-hero-wrapper .tg-text {
  display: block;
  font-family: 'Outfit', sans-serif;
  font-size: .92rem;
  font-weight: 400;
  line-height: 1.7;
  color: rgba(13,31,27,.62);
  margin-bottom: 26px;
  max-width: 360px;
  opacity: 0;
  transform: translateY(18px);
  animation: tgFade .7s ease .54s forwards;
}

#tangram-hero-wrapper .tg-btns {
  display: flex;
  align-items: center;
  gap: 14px;
  opacity: 0;
  transform: translateY(18px);
  animation: tgFade .7s ease .68s forwards;
}

@keyframes tgFade {
  to { opacity: 1; transform: translateY(0); }
}

#tangram-hero-wrapper .tg-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 30px;
  font-family: 'Outfit', sans-serif;
  font-size: .88rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 9px;
  cursor: pointer;
  transition: all .25s;
  background: #0a9e84;
  color: #fff;
  border: none;
  box-shadow: 0 8px 24px rgba(10,158,132,.32);
}

#tangram-hero-wrapper .tg-btn:hover {
  background: #077d68;
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(10,158,132,.42);
}

#tangram-hero-wrapper .tg-btn-out {
  background: transparent;
  color: #0d1f1b;
  border: 2px solid rgba(13,31,27,.18);
  padding: 13px 26px;
  font-weight: 600;
  box-shadow: none;
}

#tangram-hero-wrapper .tg-btn-out:hover {
  border-color: #0a9e84;
  color: #0a9e84;
  background: transparent;
  transform: none;
  box-shadow: none;
}

#tangram-hero-wrapper .tg-box {
  position: absolute;
  right: 5%;
  top: 14px;
  bottom: 14px;
  width: 55%;
  max-width: 720px;
  z-index: 4;
  border-radius: 14px;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-shadow: -6px 0 40px rgba(0,0,0,.1), 0 8px 32px rgba(0,0,0,.08);
  opacity: 0;
  animation: tgFade .9s ease .5s forwards;
}

#tangram-hero-wrapper .tg-top {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  background: #fff;
  border-bottom: 1px solid rgba(46,207,176,.14);
  flex-shrink: 0;
  font-family: 'Bebas Neue', sans-serif;
  font-size: .9rem;
  letter-spacing: 2px;
  color: #0d1f1b;
}

#tangram-hero-wrapper .tg-top span {
  color: #0a9e84;
}

#tangram-hero-wrapper .tg-slider {
  position: relative;
  width: 100%;
  flex: 1;
  overflow: hidden;
  background: #e8f8f5;
}

#tangram-hero-wrapper .tg-slide {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0;
  z-index: 1;
  will-change: transform, opacity;
  transform: translateX(100%);
}

#tangram-hero-wrapper .tg-slide.active {
  opacity: 1;
  z-index: 2;
  transform: translateX(0);
}

#tangram-hero-wrapper .tg-slide.slide-out {
  z-index: 2;
  animation: slideOutLeft .9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

#tangram-hero-wrapper .tg-slide.slide-in {
  z-index: 3;
  animation: slideInRight .9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes slideOutLeft {
  0% { 
    opacity: 1; 
    transform: translateX(0);
  }
  100% { 
    opacity: 0; 
    transform: translateX(-100%);
  }
}

@keyframes slideInRight {
  0% { 
    opacity: 0; 
    transform: translateX(100%);
  }
  100% { 
    opacity: 1; 
    transform: translateX(0);
  }
}

#tangram-hero-wrapper .tg-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  transition: transform .2s;
  padding: 8px;
}

#tangram-hero-wrapper .tg-nav:hover {
  background: transparent;
  transform: translateY(-50%) scale(1.2);
}

#tangram-hero-wrapper .tg-nav svg {
  width: 24px;
  height: 24px;
  filter: drop-shadow(0 2px 6px rgba(0,0,0,0.4));
}

#tangram-hero-wrapper .tg-nav-l {
  left: 16px;
}

#tangram-hero-wrapper .tg-nav-r {
  right: 16px;
}

#tangram-hero-wrapper .tg-count {
  position: absolute;
  top: 12px;
  right: 14px;
  z-index: 10;
  background: rgba(10,158,132,.82);
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: .67rem;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 3px 10px;
  border-radius: 100px;
}

#tangram-hero-wrapper .tg-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 7px 14px;
  background: #fff;
  border-top: 1px solid rgba(46,207,176,.1);
  flex-shrink: 0;
}

#tangram-hero-wrapper .tg-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #cde8e4;
  cursor: pointer;
  transition: all .3s;
  flex-shrink: 0;
}

#tangram-hero-wrapper .tg-dot.active {
  width: 20px;
  border-radius: 4px;
  background: #0a9e84;
}

#tangram-hero-wrapper .tg-label {
  margin-left: auto;
  font-family: 'Outfit', sans-serif;
  font-size: .58rem;
  color: #bbb;
  font-weight: 600;
  letter-spacing: 1px;
}

@media (max-width: 1366px) and (min-width: 1024px) {
  #tangram-hero-wrapper .tg-hero { height: 65vh; min-height: 420px; }
  #tangram-hero-wrapper .tg-content { width: 48%; padding-left: 4%; }
  #tangram-hero-wrapper .tg-box { width: 60%; right: 3%; }
  #tangram-hero-wrapper .tg-h1 { font-size: clamp(2.5rem, 4.5vw, 3.8rem); }
  #tangram-hero-wrapper .tg-text { font-size: .88rem; max-width: 340px; }
  #tangram-hero-wrapper .tg-btn { padding: 12px 24px; font-size: .82rem; }
  #tangram-hero-wrapper .tg-btn-out { padding: 11px 22px; }
}

@media (max-width: 1023px) and (min-width: 768px) {
  #tangram-hero-wrapper .tg-hero { height: 60vh; min-height: 400px; }
  #tangram-hero-wrapper .tg-content { width: 45%; padding-left: 4%; }
  #tangram-hero-wrapper .tg-box { width: 58%; right: 2%; top: 12px; bottom: 12px; }
  #tangram-hero-wrapper .tg-eyebrow { font-size: .62rem; padding: 5px 14px; }
  #tangram-hero-wrapper .tg-h1 { font-size: clamp(2.2rem, 4vw, 3.2rem); }
  #tangram-hero-wrapper .tg-text { font-size: .84rem; max-width: 300px; margin-bottom: 20px; }
  #tangram-hero-wrapper .tg-btn { padding: 11px 22px; font-size: .8rem; }
  #tangram-hero-wrapper .tg-btn-out { padding: 10px 20px; }
  #tangram-hero-wrapper .tg-nav { padding: 7px; }
  #tangram-hero-wrapper .tg-nav svg { width: 20px; height: 20px; }
}

@media (max-width: 767px) {
  #tangram-hero-wrapper .tg-hero {
    flex-direction: column;
    height: auto;
    min-height: auto;
    padding-bottom: 0;
  }
  #tangram-hero-wrapper .tg-content {
    width: 100%;
    padding: 30px 5% 24px;
    order: 2;
  }
  #tangram-hero-wrapper .tg-box {
    position: relative;
    right: auto;
    top: auto;
    bottom: auto;
    width: 100%;
    max-width: 100%;
    height: 65vw;
    min-height: 280px;
    max-height: 420px;
    border-radius: 0;
    margin: 0;
    order: 1;
  }
  #tangram-hero-wrapper .tg-eyebrow { font-size: .6rem; padding: 5px 12px; margin-bottom: 10px; }
  #tangram-hero-wrapper .tg-h1 { font-size: clamp(2.2rem, 9vw, 3rem); margin-bottom: 8px; }
  #tangram-hero-wrapper .tg-text { font-size: .82rem; margin-bottom: 16px; max-width: 100%; }
  #tangram-hero-wrapper .tg-btns { flex-wrap: wrap; }
  #tangram-hero-wrapper .tg-btn { padding: 10px 20px; font-size: .78rem; }
  #tangram-hero-wrapper .tg-btn-out { padding: 9px 16px; }
  #tangram-hero-wrapper .tg-top { padding: 5px 10px; }
  #tangram-hero-wrapper .tg-bottom { padding: 5px 10px; }
  #tangram-hero-wrapper .tg-nav { padding: 6px; }
  #tangram-hero-wrapper .tg-nav svg { width: 22px; height: 22px; }
  #tangram-hero-wrapper .tg-dot { width: 8px; height: 8px; }
  #tangram-hero-wrapper .tg-dot.active { width: 24px; }
}

@media (max-width: 420px) {
  #tangram-hero-wrapper .tg-content { padding: 24px 5% 20px; }
  #tangram-hero-wrapper .tg-box { height: 70vw; min-height: 240px; max-height: 360px; }
  #tangram-hero-wrapper .tg-eyebrow { font-size: .58rem; letter-spacing: 3px; }
  #tangram-hero-wrapper .tg-h1 { font-size: clamp(1.8rem, 10vw, 2.4rem); }
  #tangram-hero-wrapper .tg-text { font-size: .78rem; line-height: 1.6; }
  #tangram-hero-wrapper .tg-btn,
  #tangram-hero-wrapper .tg-btn-out {
    padding: 9px 18px;
    font-size: .74rem;
    width: 100%;
    justify-content: center;
  }
  #tangram-hero-wrapper .tg-nav { padding: 5px; }
  #tangram-hero-wrapper .tg-nav svg { width: 20px; height: 20px; }
  #tangram-hero-wrapper .tg-count { font-size: .62rem; padding: 2px 8px; }
}

@media (min-width: 1920px) {
  #tangram-hero-wrapper .tg-hero { height: 75vh; max-height: 900px; }
  #tangram-hero-wrapper .tg-content { max-width: 700px; }
  #tangram-hero-wrapper .tg-box { max-width: 1100px; }
  #tangram-hero-wrapper .tg-h1 { font-size: clamp(3.5rem, 5vw, 5.5rem); }
  #tangram-hero-wrapper .tg-text { font-size: 1.05rem; max-width: 480px; }
}
</style>
</head>
<body style="margin:0;padding:0;overflow-x:hidden;width:100%;max-width:100%;">

<div id="tangram-hero-wrapper" style="margin-left:calc(-50vw + 50%);margin-right:calc(-50vw + 50%);width:100vw;max-width:100vw;overflow-x:hidden;">
  <div class="tg-hero">
    <div class="tg-box">
      <div class="tg-top">TANGRAM <span>Technology Ltd.</span></div>
      <div class="tg-slider">
        <div class="tg-slide active" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-09-at-09.26.19-1.jpeg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/02.-3x2-aircompressor-scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/03.-3x2-Spirit--scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/04-3x2-Secure--scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/10ft-x-4ft-MD-sir-room-scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/66inch-vs-36inch-SUmon-BHai-room-scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/05-3x2ft-LED-Light-scaled.jpg"></div>
        <div class="tg-slide" data-src="https://tangramelectronics.com/wp-content/uploads/2026/02/629664381_884224754474112_2005643736107419374_n.jpg"></div>
        <button class="tg-nav tg-nav-l" id="tgPrev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="tg-nav tg-nav-r" id="tgNext" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="tg-count" id="tgCount">1 / 8</div>
      </div>
      <div class="tg-bottom">
        <div class="tg-dot active" data-idx="0"></div>
        <div class="tg-dot" data-idx="1"></div>
        <div class="tg-dot" data-idx="2"></div>
        <div class="tg-dot" data-idx="3"></div>
        <div class="tg-dot" data-idx="4"></div>
        <div class="tg-dot" data-idx="5"></div>
        <div class="tg-dot" data-idx="6"></div>
        <div class="tg-dot" data-idx="7"></div>
        <span class="tg-label">PRECISION · RELIABLE</span>
      </div>
    </div>
    <div class="tg-content">
      
      <div class="tg-h1">TANGRAM <span class="tg-accent">ELECTRONICS</span></div>
